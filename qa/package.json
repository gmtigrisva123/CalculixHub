{
  "name": "calculixhub-qa",
  "private": true,
  "type": "module",
  "description": "Live-site QA for CalculixHub: scripted browser bots, agent browser sessions, and the report. landing/ holds the landing page's QA harness, run against a local build.",
  "scripts": {
    "identities": "node identities.mjs",
    "preflight": "node preflight.mjs",
    "bots": "node bots/run.mjs",
    "report": "node report/build.mjs",
    "landing": "playwright test -c landing/playwright.config.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
