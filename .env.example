# CalculixHub configuration.
#
# Every value here has a secure default. Copy to `.env` and set only what you
# need to change -- an empty file is a valid development configuration.
#
# The server validates all of these at boot and refuses to start if any is
# malformed. A limit that silently degraded to "off" because of a typo would be
# worse than no limit, because it would still be believed.

# --- Secrets ------------------------------------------------------------------

# GEMINI_API_KEY: enables the AI tutor, answer commentary and recommendations.
#
# Optional. Without it every AI route serves the deterministic engine, which is
# a fully supported mode -- it is exactly how the GitHub Pages deployment runs.
# The literal "MY_GEMINI_API_KEY" is treated as absent.
GEMINI_API_KEY=""

# --- Origins ------------------------------------------------------------------

# ALLOWED_ORIGINS: comma-separated browser origins permitted to call the API.
#
# REQUIRED in production; the server refuses to boot without it, rather than
# defaulting open and exposing the paid AI routes to every origin on the
# internet. Entries must be absolute and https (localhost excepted). The
# Capacitor origins the iOS shell uses are always allowed and need not be
# listed, and localhost origins are added automatically outside production.
#
#   ALLOWED_ORIGINS="https://calculixhub.vercel.app,https://www.calculixhub.com"
ALLOWED_ORIGINS=""

# TRUST_PROXY: whether x-forwarded-for may be believed when identifying clients.
#
# Set to "true" ONLY when a proxy you control overwrites the header -- Vercel
# does. If the process is reachable directly, leaving this false is essential:
# a client that can set its own forwarded address would get a fresh rate-limit
# allowance on every request, which is how rate limiting is usually defeated.
TRUST_PROXY="false"

# --- Cost and abuse controls --------------------------------------------------

# AI_DAILY_CALL_BUDGET: hard ceiling on upstream model calls per day, across all
# clients. This is the control that bounds total spend -- per-client rate limits
# only bound the rate of one caller. Past the ceiling the deterministic engine
# serves every request, so exhaustion costs answer quality, not availability.
# Set to 0 to disable upstream calls entirely without removing the key.
AI_DAILY_CALL_BUDGET="1000"

# Per-client allowances. AI routes cost money per call; reads do not, so they
# are counted separately -- spending the AI allowance must not lock a learner
# out of loading the item bank.
RATE_LIMIT_AI_MAX="20"
RATE_LIMIT_AI_WINDOW_S="60"
RATE_LIMIT_READ_MAX="120"
RATE_LIMIT_READ_WINDOW_S="60"

# Request and response bounds. Each one caps the size of a single upstream
# prompt, and therefore its cost.
MAX_BODY_BYTES="16384"
MAX_TEXT_CHARS="4000"
AI_MAX_OUTPUT_TOKENS="1024"

# AI_TIMEOUT_MS: deadline for one upstream call. Without it a hung upstream
# holds a serverless invocation open until the platform kills it, turning an
# upstream slowdown into exhausted concurrency here.
AI_TIMEOUT_MS="12000"

# GEMINI_MODEL: the model identifier to call.
#
# Configurable because the previously hardcoded "gemini-3.5-flash" does not
# correspond to a published model: every call would have failed and silently
# fallen back, making a broken AI layer indistinguishable from a missing key.
# Set this to a model your project actually has access to.
GEMINI_MODEL="gemini-2.5-flash"

# --- Client build -------------------------------------------------------------

# VITE_API_BASE_URL: absolute backend origin, baked into the client at build time.
#
# Leave UNSET for web builds. The site and the API share an origin there, so
# relative /api/* paths are correct and follow the deployment automatically.
#
# REQUIRED for the iOS build. Inside the native WebView the bundle is not served
# from your domain, so a relative /api/chat never reaches the server. Set it to
# the deployed backend origin, with no trailing slash:
#
#   VITE_API_BASE_URL="https://your-project.vercel.app"
#
# Building the iOS app without it produces an app whose AI tutor, grading and
# recommendations all fail; src/lib/apiBase.ts logs an explicit error in that
# case rather than issuing requests that cannot succeed.
VITE_API_BASE_URL=""
