# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Absolute backend origin, baked into the client at build time.
#
# Leave this UNSET for web builds. The site and the API share an origin there, so
# relative /api/* paths are correct and follow the deployment automatically.
#
# REQUIRED for the iOS build. Inside the native WebView the bundle is not served
# from your domain, so a relative /api/chat never reaches the server. Set it to
# the deployed backend origin, with no trailing slash:
#
#   VITE_API_BASE_URL="https://your-project.vercel.app"
#
# Building the iOS app without it produces an app whose AI tutor, grading and
# recommendations all fail; src/lib/apiBase.ts logs an explicit error in that case
# rather than issuing requests that cannot succeed.
VITE_API_BASE_URL=""
