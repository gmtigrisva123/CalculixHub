{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || pip install --break-system-packages -q 'graphifyy[sql]' >/dev/null 2>&1; command -v graphify >/dev/null 2>&1 && [ -d .git ] && graphify hook install >/dev/null 2>&1; exit 0",
            "timeout": 180
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
