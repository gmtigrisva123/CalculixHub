{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Declares import.meta.env, which src/lib/pwa.ts reads to resolve BASE_URL.
    // Vite substitutes it at build time; without this tsc rejects the property.
    "types": [
      "vite/client"
    ]
  },
  // Everything server-side is checked by `tsconfig.server.json` instead, which
  // enables `strict`. It is excluded here rather than checked twice: this
  // configuration has `strictNullChecks` off, under which TypeScript cannot
  // narrow a discriminated union on a boolean discriminant and Zod infers every
  // field as optional. Checking correct strict code with it produces errors
  // that describe the configuration rather than the code.
  //
  // Each file therefore has exactly one owning configuration, and `npm run
  // lint` runs both. Client directories move to the strict config over time.
  "exclude": [
    "node_modules",
    "dist",
    "calculix_realtime_patch",
    "src/server",
    "api",
    "server.ts",
    "vitest.config.ts"
  ]
}
