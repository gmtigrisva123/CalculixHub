{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    /*
     * `strictNullChecks` is on here, separately from the full `strict` that
     * tsconfig.server.json enables.
     *
     * It is not only a client-code improvement. Vercel type-checks the API
     * entry point with *this* file — the `exclude` below governs `tsc` runs,
     * not Vercel's builder — and without `strictNullChecks` TypeScript cannot
     * narrow a discriminated union on a boolean discriminant, nor infer Zod
     * fields as required. The deploy log therefore filled with errors about
     * `BodyResult.response` and optional `content` fields: correct strict code,
     * reported against a configuration that could not describe it.
     *
     * Turning it on cost exactly one fix (src/lib/data/realtime.ts), which was
     * a real unchecked dereference rather than a false positive.
     */
    "strictNullChecks": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // Declares import.meta.env, which src/lib/pwa.ts reads to resolve BASE_URL.
    // Vite substitutes it at build time; without this tsc rejects the property.
    "types": [
      "vite/client"
    ]
  },
  // Everything server-side is checked by `tsconfig.server.json` instead, which
  // enables the full `strict`. It is excluded here rather than checked twice,
  // so each file has exactly one owning configuration and `npm run lint` runs
  // both.
  //
  // The exclusion is a `tsc` convenience, not a guarantee: Vercel's builder
  // compiles `api/**` against this file regardless of what is listed here,
  // which is why `strictNullChecks` above is not optional. Removing it would
  // not quieten the deploy — it would only move the errors back into it.
  "exclude": [
    "node_modules",
    "dist",
    "calculix_realtime_patch",
    "src/server",
    "api",
    "server.ts",
    "vitest.config.ts"
  ]
}
